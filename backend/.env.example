# Puerto del servidor
PORT=3000
NODE_ENV=development

# En Railway, esta variable se inyecta automáticamente si conectas PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tienda_celulares

# O configuración individual si no usas DATABASE_URL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tienda_celulares

# URL del Frontend desplegado en Netlify (para restringir CORS en producción si se desea)
FRONTEND_URL=http://localhost:5173
